# Copie este arquivo para ".env" e preencha com suas chaves reais.
# NUNCA suba o arquivo ".env" (com as chaves de verdade) para o GitHub.

API_FOOTBALL_KEY=coloque_sua_chave_da_api_football_aqui
TELEGRAM_BOT_TOKEN=coloque_o_token_do_seu_bot_aqui
TELEGRAM_CHAT_ID=coloque_seu_chat_id_aqui
GEMINI_API_KEY=coloque_sua_chave_do_gemini_aqui

# Opcionais (valores padrão já funcionam)
GEMINI_MODEL=gemini-2.5-flash
CONFIDENCE_THRESHOLD=70
REQUIRE_POSITIVE_EDGE=false
LEAGUE_IDS=
SOT_CONVERSION_FACTOR=0.30
MAX_FIXTURES=8
REQUEST_DELAY_SECONDS=6
